# --- ESPN ---
# The leagueId= value in your league URL.
ESPN_LEAGUE_ID=
ESPN_SEASON=2026

# Private leagues only. USE YOUR OWN — these are live session tokens for your
# personal ESPN account. fantasy.espn.com > Cmd+Option+I > Application >
# Cookies > https://fantasy.espn.com > copy espn_s2 and SWID (keep the braces).
ESPN_S2=
ESPN_SWID=

# --- iMessage ---
# Run: ./venv/bin/python -m schefter.chats
IMESSAGE_CHAT_ID=

# --- Polls ---
# Plain-text polls tallied from unprefixed replies. Off means bare numbers
# ("2") are never read as votes.
POLLS_ENABLED=1

# --- Interactive group-chat agent (BlueBubbles inbound webhook) ---
# After installing BlueBubbles Server, add this webhook URL for New Messages:
# http://127.0.0.1:8765/webhook?token=<the same random secret below>
AGENT_ENABLED=0
AGENT_WEBHOOK_SECRET=
AGENT_TRIGGER=schefter
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# Create a key at https://platform.openai.com/api-keys. Never paste it in chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AGENT_WEB_SEARCH=1
AGENT_HISTORY_SIZE=10
AGENT_MAX_REPLY_CHARS=1800
AGENT_MAX_QUESTION_CHARS=1200

# --- In-chat trade proposals ---
# Map the exact BlueBubbles sender address for every manager to the exact ESPN
# team name. A recipient can reply with just Yes/No when only one offer is pending.
TRADE_ENABLED=0
TRADE_MANAGERS={"+15551234567":"Team One","manager@example.com":"Team Two"}
TRADE_ALLOW_BARE_RESPONSES=1
TRADE_EXECUTION_PROVIDER=none  # none, espn, or webhook

# ESPN execution uses ESPN's unsupported web-client API. Use league_manager when
# ESPN_S2/ESPN_SWID belong to the league commissioner. Set both switches to opt in.
ESPN_TRADE_WRITE_ENABLED=0
ESPN_TRADE_AUTH_MODE=league_manager  # league_manager or team_credentials
# For team_credentials mode only. Keep this JSON file outside the repository.
ESPN_TRADE_CREDENTIALS_FILE=
# Optional HTTPS adapter invoked only after the recipient accepts. Yahoo can use
# its official OAuth API; ESPN requires a separately maintained adapter because
# ESPN offers no public write API.
TRADE_EXECUTION_WEBHOOK_URL=
TRADE_EXECUTION_SECRET=

# --- Features ---
# Defaults are the "high signal" set: ~3-8 messages in a normal week.
FEATURE_TRANSACTIONS=1   # adds, drops, waivers, trades (every poll)
FEATURE_INJURIES=1       # rostered player injury status changes (every poll)
FEATURE_INACTIVES=1      # Sunday pre-kickoff dead-starter sweep
FEATURE_RECAP=1          # Tuesday recap + bench blunders
FEATURE_RANKINGS=1       # Tuesday power rankings with movement
FEATURE_RUMORS=1         # Tue/Thu speculative trade rumors (fabricated, tagged as such)
RUMOR_CHANCE=0.65        # flat odds all season, used only if the league has no trade deadline set
RUMOR_CHANCE_MIN=0.25    # odds early in the season, before the ramp toward the deadline starts
RUMOR_CHANCE_PEAK=0.9    # odds during the week before + the week of the trade deadline
                         # (also fires on extra days that week — Sun/Tue/Wed/Thu — for ~3-4 rumors)
RUMOR_CHANCE_POST=0.75   # odds after the trade deadline, back to the normal Tue/Thu cadence
RUMOR_RAMP_WEEKS=8       # weeks before the peak window over which odds ramp MIN -> PEAK
FEATURE_DRAFT_LOTTERY=1  # on-demand only; run with:
                         #   python -m schefter.main --only draft_lottery --force --send

# Most rostered players are Questionable at some point; announcing them all is
# the fastest way to get the bot muted. Off by default.
ANNOUNCE_QUESTIONABLE=0

# NFL schedule logic runs on Eastern regardless of where this Mac sits.
TIMEZONE=America/New_York

# --- Tuning ---
FETCH_SIZE=25       # activities pulled per poll
MAX_PER_POLL=6      # more new items than this in one poll -> single digest
DRY_RUN=            # set to 1 to print instead of send
